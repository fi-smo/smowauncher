// Smowauncher main window — Raycast-like dark launcher.

export struct ResultItem {
    title: string,
    subtitle: string,
    badge: string,
    section: string,       // non-empty => draw a section header above this row
    icon: image,
    has-icon: bool,
    glyph: string,         // fallback when there is no icon
    y: length,             // precomputed offset inside the list
    h: length,             // row height incl. optional section header
}

export global Theme {
    in property <bool> acrylic: true;
    out property <color> window-bg: acrylic ? #18181ce0 : #1c1c1f;
    out property <color> border: #ffffff14;
    out property <color> divider: #ffffff12;
    out property <color> text: #f2f2f4;
    out property <color> text-dim: #9a9aa2;
    out property <color> text-faint: #6c6c74;
    out property <color> selection: #ffffff17;
    out property <color> accent: #ff6363;
    out property <color> key-bg: #ffffff14;
    out property <length> row-height: 46px;
    out property <length> header-height: 30px;
    out property <string> font: "Segoe UI Variable Text";
}

component KeyCap inherits Rectangle {
    in property <string> text;
    height: 20px;
    width: max(20px, label.preferred-width + 10px);
    border-radius: 5px;
    background: Theme.key-bg;
    label := Text {
        text: root.text;
        color: Theme.text-dim;
        font-size: 11px;
        font-family: Theme.font;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

component ResultRow inherits Rectangle {
    in property <ResultItem> item;
    in property <bool> selected;
    callback clicked();
    callback hovered();

    height: item.h;

    if item.section != "": Text {
        x: 16px;
        y: 10px;
        text: item.section;
        color: Theme.text-faint;
        font-size: 11px;
        font-weight: 600;
        font-family: Theme.font;
        letter-spacing: 0.4px;
    }

    row := Rectangle {
        x: 8px;
        y: item.h - Theme.row-height;
        width: parent.width - 16px;
        height: Theme.row-height;
        border-radius: 9px;
        background: root.selected ? Theme.selection : transparent;

        if item.has-icon: Image {
            x: 12px;
            y: (parent.height - self.height) / 2;
            width: 26px;
            height: 26px;
            source: item.icon;
            image-fit: contain;
        }
        if !item.has-icon: Rectangle {
            x: 12px;
            y: (parent.height - self.height) / 2;
            width: 26px;
            height: 26px;
            border-radius: 6px;
            background: #ffffff10;
            Text {
                text: item.glyph;
                color: Theme.text-dim;
                font-size: 13px;
                font-family: Theme.font;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        title := Text {
            x: 50px;
            width: min(self.preferred-width, parent.width - 50px - badge.preferred-width - 40px);
            y: (parent.height - self.height) / 2;
            text: item.title;
            color: Theme.text;
            font-size: 14px;
            font-family: Theme.font;
            overflow: elide;
        }
        Text {
            x: title.x + title.width + 10px;
            width: max(0px, parent.width - self.x - badge.preferred-width - 28px);
            y: (parent.height - self.height) / 2;
            text: item.subtitle;
            color: Theme.text-faint;
            font-size: 13px;
            font-family: Theme.font;
            overflow: elide;
        }
        badge := Text {
            x: parent.width - self.width - 14px;
            y: (parent.height - self.height) / 2;
            text: item.badge;
            color: Theme.text-faint;
            font-size: 12px;
            font-family: Theme.font;
        }
    }

    TouchArea {
        clicked => { root.clicked(); }
        moved => { root.hovered(); }
    }
}

export component LauncherWindow inherits Window {
    title: "Smowauncher";
    no-frame: true;
    background: transparent;
    width: 760px;
    height: 474px;
    default-font-family: Theme.font;

    in property <[ResultItem]> results;
    in-out property <int> selected: 0;
    in-out property <string> query;
    in property <string> placeholder: "Search apps and commands…";
    in property <string> status;
    in property <string> primary-action: "Open";
    in property <string> empty-text: "Type to search";
    // Bumped by Rust on every show so the entrance animation replays.
    in property <bool> shown: false;

    callback query-edited(string);
    callback activate(int, int);   // index, modifier (0 none, 1 ctrl, 2 ctrl+shift)
    callback escape();

    public function focus-input() {
        input.focus();
    }
    public function reset-scroll() {
        list.content-y = 0;
    }

    function ensure-visible() {
        if (root.selected < 0 || root.selected >= root.results.length) { return; }
        let item = root.results[root.selected];
        if (item.y + item.h + list.content-y > list.height) {
            list.content-y = list.height - item.y - item.h;
        }
        // Keep the section header visible when scrolling up onto a sectioned row.
        if (item.y + list.content-y < 0) {
            list.content-y = -item.y;
        }
    }
    function move(delta: int) {
        if (root.results.length == 0) { return; }
        root.selected = Math.mod(root.selected + delta + root.results.length, root.results.length);
        root.ensure-visible();
    }

    // Window chrome: translucent tint over the DWM acrylic backdrop (or solid).
    Rectangle {
        background: Theme.window-bg;
        border-radius: 0px;
    }

    content := Rectangle {
        opacity: root.shown ? 1 : 0;
        y: root.shown ? 0px : 4px;
        animate opacity { duration: root.shown ? 110ms : 0ms; easing: ease-out; }
        animate y { duration: root.shown ? 140ms : 0ms; easing: ease-out; }

        // Search bar
        FocusScope {
            x: 0; y: 0;
            width: parent.width;
            height: 58px;
            capture-key-pressed(event) => {
                if (event.text == Key.UpArrow) {
                    root.move(-1);
                    return accept;
                }
                if (event.text == Key.DownArrow) {
                    root.move(1);
                    return accept;
                }
                if (event.modifiers.control && (event.text == "j" || event.text == "n")) {
                    root.move(1);
                    return accept;
                }
                if (event.modifiers.control && event.text == "p") {
                    root.move(-1);
                    return accept;
                }
                if (event.text == Key.PageDown) { root.move(8); return accept; }
                if (event.text == Key.PageUp) { root.move(-8); return accept; }
                if (event.text == Key.Return) {
                    root.activate(root.selected,
                        event.modifiers.control && event.modifiers.shift ? 2 : event.modifiers.control ? 1 : 0);
                    return accept;
                }
                if (event.text == Key.Escape) {
                    root.escape();
                    return accept;
                }
                reject
            }

            Path {
                x: 20px;
                y: (parent.height - self.height) / 2;
                width: 18px;
                height: 18px;
                viewbox-width: 18;
                viewbox-height: 18;
                commands: "M 7.5 1.5 A 6 6 0 1 1 7.49 1.5 Z M 12 12 L 16.5 16.5";
                stroke: Theme.text-faint;
                stroke-width: 1.8px;
            }
            if input.text == "": Text {
                x: input.x;
                y: input.y;
                height: input.height;
                vertical-alignment: center;
                text: root.placeholder;
                color: Theme.text-faint;
                font-size: 18px;
            }
            input := TextInput {
                x: 50px;
                width: parent.width - 70px;
                height: 28px;
                y: (parent.height - self.height) / 2;
                vertical-alignment: center;
                text <=> root.query;
                color: Theme.text;
                font-size: 18px;
                single-line: true;
                selection-background-color: #ff636366;
                selection-foreground-color: Theme.text;
                edited => { root.query-edited(self.text); }
            }
        }

        Rectangle {
            y: 58px;
            height: 1px;
            background: Theme.divider;
        }

        list := Flickable {
            y: 59px;
            height: parent.height - 59px - 38px;
            content-height: root.results.length > 0
                ? root.results[root.results.length - 1].y + root.results[root.results.length - 1].h + 8px
                : 0px;
            for item[i] in root.results: ResultRow {
                y: item.y;
                width: parent.width;
                item: item;
                selected: i == root.selected;
                clicked => { root.selected = i; root.activate(i, 0); }
                hovered => { root.selected = i; }
            }
        }

        if root.results.length == 0: Text {
            x: 32px;
            y: 59px + 60px;
            width: parent.width - 64px;
            horizontal-alignment: center;
            overflow: elide;
            text: root.empty-text;
            color: Theme.text-faint;
            font-size: 13px;
        }

        // Footer
        Rectangle {
            y: parent.height - 38px;
            height: 38px;
            background: #ffffff06;
            Rectangle {
                y: 0;
                height: 1px;
                background: Theme.divider;
            }
            Rectangle {
                x: 16px;
                y: (parent.height - self.height) / 2;
                width: 14px;
                height: 14px;
                border-radius: 4px;
                background: @linear-gradient(135deg, #ff7a7a 0%, #ff4d6d 100%);
            }
            Text {
                x: 38px;
                y: (parent.height - self.height) / 2;
                text: root.status;
                color: Theme.text-faint;
                font-size: 12px;
            }
            HorizontalLayout {
                width: self.preferred-width;
                x: parent.width - self.width - 14px;
                y: (parent.height - 20px) / 2;
                height: 20px;
                spacing: 6px;
                Text {
                    text: root.primary-action;
                    color: Theme.text-dim;
                    font-size: 12px;
                    vertical-alignment: center;
                }
                KeyCap { text: "Enter"; }
                Rectangle { width: 8px; }
                Text {
                    text: "Open folder";
                    color: Theme.text-faint;
                    font-size: 12px;
                    vertical-alignment: center;
                }
                KeyCap { text: "Ctrl"; }
                KeyCap { text: "Enter"; }
            }
        }
    }
}
