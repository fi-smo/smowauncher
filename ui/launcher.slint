import { SettingsWindow, Engine, SnippetItem, AiCommandItem } from "settings.slint";
export { SettingsWindow, Engine, SnippetItem, AiCommandItem }

// Smowauncher main window — Raycast-like dark launcher.

export struct ResultItem {
    title: string,
    subtitle: string,
    badge: string,
    section: string,       // non-empty => draw a section header above this row
    icon: image,
    has-icon: bool,
    glyph: string,         // fallback when there is no icon
    y: length,             // precomputed offset inside the list
    h: length,             // row height incl. optional section header
    action: string,        // primary action label for the footer ("Open", "Open Folder", ...)
    hero: bool,            // calculator card: subtitle = expression, title = result
    icon-font: bool,       // glyph is a Segoe Fluent Icons code point
    warning: bool,         // subtitle in accent color (e.g. "press Enter again to confirm")
    chip-left: string,     // hero: currency symbol next to the expression
    chip-right: string,    // hero: currency symbol next to the result
    label-right: string,   // hero: caption under the result (default "Enter to copy")
    big-glyph: bool,       // glyph is an emoji: drawn large, without the tile
}

export struct ActionItem {
    title: string,
    shortcut: string,
    id: string,
}

export global Theme {
    in property <bool> acrylic: true;
    in property <bool> dark: true;
    out property <color> window-bg: dark ? (acrylic ? #18181ce0 : #1c1c1f) : (acrylic ? #f7f7f9d8 : #f7f7f9);
    out property <color> border: dark ? #ffffff14 : #00000014;
    out property <color> divider: dark ? #ffffff12 : #00000010;
    out property <color> text: dark ? #f2f2f4 : #1b1b1f;
    out property <color> text-dim: dark ? #9a9aa2 : #55555e;
    out property <color> text-faint: dark ? #6c6c74 : #85858f;
    out property <color> selection: dark ? #ffffff17 : #0000000f;
    out property <color> accent: dark ? #ff6363 : #e5484d;
    out property <color> key-bg: dark ? #ffffff14 : #0000000d;
    out property <color> chip-bg: dark ? #ffffff14 : #0000000d;
    out property <color> card-bg: dark ? #ffffff0a : #00000008;
    out property <color> glyph-bg: dark ? #ffffff10 : #0000000b;
    out property <color> footer-bg: dark ? #ffffff06 : #00000005;
    out property <color> panel-bg: dark ? #232327fa : #fcfcfdfa;
    out property <color> panel-border: dark ? #ffffff1c : #0000001a;
    out property <color> shadow: dark ? #00000090 : #00000030;
    out property <color> text-selection: dark ? #ff636366 : #e5484d44;
    out property <length> row-height: 46px;
    out property <length> header-height: 30px;
    out property <length> hero-height: 72px;
    out property <string> font: "Segoe UI Variable Text";
}

component KeyCap inherits Rectangle {
    in property <string> text;
    height: 20px;
    width: max(20px, label.preferred-width + 10px);
    border-radius: 5px;
    background: Theme.key-bg;
    label := Text {
        text: root.text;
        color: Theme.text-dim;
        font-size: 11px;
        font-family: Theme.font;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

/// Currency symbol badge (stands in for a flag: Windows can't render flag emoji).
component CurrencyChip inherits Rectangle {
    in property <string> text;
    in property <bool> big: false;
    height: big ? 30px : 26px;
    width: max(self.height, label.preferred-width + 14px);
    border-radius: 7px;
    background: Theme.chip-bg;
    label := Text {
        text: root.text;
        color: Theme.text;
        font-size: big ? 15px : 13px;
        font-weight: 600;
        font-family: Theme.font;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component ResultRow inherits Rectangle {
    in property <ResultItem> item;
    in property <bool> selected;
    callback clicked();
    callback hovered();

    height: item.h;

    if item.section != "": Text {
        x: 16px;
        y: 10px;
        text: item.section;
        color: Theme.text-faint;
        font-size: 11px;
        font-weight: 600;
        font-family: Theme.font;
        letter-spacing: 0.4px;
    }

    // Calculator / conversion card: expression → result. No border: a 1px translucent
    // stroke at fractional scale factors renders unevenly with the software renderer.
    if item.hero: Rectangle {
        x: 8px;
        y: item.h - Theme.hero-height;
        width: parent.width - 16px;
        height: Theme.hero-height;
        border-radius: 10px;
        background: root.selected ? Theme.selection : Theme.card-bg;
        animate background { duration: 90ms; easing: ease-out; }

        HorizontalLayout {
            x: 20px;
            y: (parent.height - 28px) / 2 - 8px;
            width: parent.width / 2 - 50px;
            height: 28px;
            spacing: 8px;
            alignment: start;
            if item.chip-left != "": CurrencyChip { text: item.chip-left; }
            Text {
                text: item.subtitle;
                color: Theme.text-dim;
                font-size: 18px;
                font-family: Theme.font;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        Text {
            x: 20px;
            y: parent.height / 2 + 12px;
            text: item.badge;
            color: Theme.text-faint;
            font-size: 11px;
            font-family: Theme.font;
        }
        Text {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 - 8px;
            text: "→";
            color: Theme.text-faint;
            font-size: 18px;
            font-family: Theme.font;
        }
        HorizontalLayout {
            x: parent.width / 2 + 30px;
            y: (parent.height - 32px) / 2 - 8px;
            width: parent.width / 2 - 50px;
            height: 32px;
            spacing: 8px;
            alignment: start;
            if item.chip-right != "": CurrencyChip { text: item.chip-right; big: true; }
            Text {
                text: item.title;
                color: Theme.text;
                font-size: 24px;
                font-weight: 600;
                font-family: Theme.font;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        Text {
            x: parent.width / 2 + 30px;
            y: parent.height / 2 + 12px;
            text: item.label-right != "" ? item.label-right : "Enter to copy";
            color: Theme.text-faint;
            font-size: 11px;
            font-family: Theme.font;
        }
    }

    if !item.hero: Rectangle {
        x: 8px;
        y: item.h - Theme.row-height;
        width: parent.width - 16px;
        height: Theme.row-height;
        border-radius: 9px;
        background: root.selected ? Theme.selection : transparent;
        animate background { duration: 90ms; easing: ease-out; }

        if item.has-icon: Image {
            x: 12px;
            y: (parent.height - self.height) / 2;
            width: 26px;
            height: 26px;
            source: item.icon;
            image-fit: contain;
        }
        if !item.has-icon: Rectangle {
            x: 12px;
            y: (parent.height - self.height) / 2;
            width: 26px;
            height: 26px;
            border-radius: 6px;
            background: item.big-glyph ? transparent : Theme.glyph-bg;
            Text {
                text: item.glyph;
                color: Theme.text-dim;
                font-size: item.big-glyph ? 21px : item.icon-font ? 14px : 13px;
                font-family: item.icon-font ? "Segoe Fluent Icons" : item.big-glyph ? "Segoe UI Emoji" : Theme.font;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        title := Text {
            x: 50px;
            width: min(self.preferred-width, parent.width - 50px - badge.preferred-width - 40px);
            y: (parent.height - self.height) / 2;
            text: item.title;
            color: Theme.text;
            font-size: 14px;
            font-family: Theme.font;
            overflow: elide;
        }
        Text {
            x: title.x + title.width + 10px;
            width: max(0px, parent.width - self.x - badge.preferred-width - 28px);
            y: (parent.height - self.height) / 2;
            text: item.subtitle;
            color: item.warning ? Theme.accent : Theme.text-faint;
            font-size: 13px;
            font-family: Theme.font;
            overflow: elide;
        }
        badge := Text {
            x: parent.width - self.width - 14px;
            y: (parent.height - self.height) / 2;
            text: item.badge;
            color: Theme.text-faint;
            font-size: 12px;
            font-family: Theme.font;
        }
    }

    TouchArea {
        clicked => { root.clicked(); }
        moved => { root.hovered(); }
    }
}

export component LauncherWindow inherits Window {
    title: "Smowauncher";
    no-frame: true;
    background: transparent;
    width: 760px;
    height: 474px;
    default-font-family: Theme.font;

    in property <[ResultItem]> results;
    in-out property <int> selected: 0;
    in-out property <string> query;
    in property <string> placeholder: "Search apps, files and commands…";
    in property <string> status;
    in property <string> empty-text: "Type to search";
    // Toggled by Rust on every show so the entrance animation replays.
    in property <bool> shown: false;

    // Preview panel for the selected file / clipboard entry / snippet.
    in property <bool> preview-visible: false;
    in property <image> preview-image;
    in property <bool> preview-has-image: false;
    // A real thumbnail (shown large) rather than an icon.
    in property <bool> preview-thumbnail: false;
    in property <string> preview-title;
    in property <string> preview-meta;
    in property <string> preview-text;

    // AI answer view (replaces the list while a conversation is open).
    in property <bool> ai-visible: false;
    in property <string> ai-question;
    in property <string> ai-answer;
    in property <string> ai-status;

    // Ctrl+K action panel for the selected row.
    in-out property <bool> actions-open: false;
    in property <[ActionItem]> actions;
    in-out property <int> action-selected: 0;

    callback query-edited(string);
    // Runs action `id` ("open", "folder", "admin", "properties", "copy-path", ...) on row `index`.
    callback activate(int, string);
    callback open-actions(int);
    callback open-settings();
    callback escape();
    callback selection-changed(int);

    changed selected => {
        root.selection-changed(root.selected);
    }

    public function focus-input() {
        input.focus();
    }
    public function reset-scroll() {
        list.content-y = 0;
    }
    // Follows a streaming answer.
    public function ai-scroll-end() {
        ai-view.content-y = min(0px, ai-view.height - ai-view.content-height);
    }

    function ensure-visible() {
        if (root.selected < 0 || root.selected >= root.results.length) { return; }
        let item = root.results[root.selected];
        if (item.y + item.h + list.content-y > list.height) {
            list.content-y = list.height - item.y - item.h;
        }
        // Keep the section header visible when scrolling up onto a sectioned row.
        if (item.y + list.content-y < 0) {
            list.content-y = -item.y;
        }
    }
    function move(delta: int) {
        if (root.results.length == 0) { return; }
        root.selected = Math.mod(root.selected + delta + root.results.length, root.results.length);
        root.ensure-visible();
    }
    function move-action(delta: int) {
        if (root.actions.length == 0) { return; }
        root.action-selected = Math.mod(root.action-selected + delta + root.actions.length, root.actions.length);
    }
    function run-selected-action() {
        if (root.action-selected >= 0 && root.action-selected < root.actions.length) {
            root.actions-open = false;
            root.activate(root.selected, root.actions[root.action-selected].id);
        }
    }

    // Window chrome: translucent tint over the DWM acrylic backdrop (or solid).
    Rectangle {
        background: Theme.window-bg;
        border-radius: 0px;
    }

    content := Rectangle {
        opacity: root.shown ? 1 : 0;
        y: root.shown ? 0px : 4px;
        animate opacity { duration: root.shown ? 110ms : 0ms; easing: ease-out; }
        animate y { duration: root.shown ? 140ms : 0ms; easing: ease-out; }

        // Search bar
        FocusScope {
            x: 0; y: 0;
            width: parent.width;
            height: 58px;
            capture-key-pressed(event) => {
                if (root.actions-open) {
                    if (event.text == Key.Escape || (event.modifiers.control && (event.text == "k" || event.text == "K"))) {
                        root.actions-open = false;
                    } else if (event.text == Key.UpArrow || (event.modifiers.control && event.text == "p")) {
                        root.move-action(-1);
                    } else if (event.text == Key.DownArrow || (event.modifiers.control && (event.text == "j" || event.text == "n"))) {
                        root.move-action(1);
                    } else if (event.text == Key.Return) {
                        root.run-selected-action();
                    }
                    // The panel is modal: swallow everything else.
                    return accept;
                }
                if (event.modifiers.control && event.text == ",") {
                    root.open-settings();
                    return accept;
                }
                if (event.modifiers.control && (event.text == "k" || event.text == "K")) {
                    if (root.results.length > 0) {
                        root.open-actions(root.selected);
                    }
                    return accept;
                }
                if (event.text == Key.UpArrow || (event.modifiers.control && event.text == "p")) {
                    root.move(-1);
                    return accept;
                }
                if (event.text == Key.DownArrow || (event.modifiers.control && (event.text == "j" || event.text == "n"))) {
                    root.move(1);
                    return accept;
                }
                if (event.text == Key.PageDown) { root.move(8); return accept; }
                if (event.text == Key.PageUp) { root.move(-8); return accept; }
                if (event.text == Key.Return) {
                    root.activate(root.selected,
                        event.modifiers.alt ? "properties"
                        : event.modifiers.control && event.modifiers.shift ? "admin"
                        : event.modifiers.control ? "folder"
                        : "open");
                    return accept;
                }
                if (event.modifiers.control && event.modifiers.shift && (event.text == "c" || event.text == "C")) {
                    root.activate(root.selected, "copy-path");
                    return accept;
                }
                if (event.text == Key.Escape) {
                    root.escape();
                    return accept;
                }
                reject
            }

            Path {
                x: 20px;
                y: (parent.height - self.height) / 2;
                width: 18px;
                height: 18px;
                viewbox-width: 18;
                viewbox-height: 18;
                commands: "M 7.5 1.5 A 6 6 0 1 1 7.49 1.5 Z M 12 12 L 16.5 16.5";
                stroke: Theme.text-faint;
                stroke-width: 1.8px;
            }
            if input.text == "": Text {
                x: input.x;
                y: input.y;
                height: input.height;
                vertical-alignment: center;
                text: root.placeholder;
                color: Theme.text-faint;
                font-size: 18px;
            }
            input := TextInput {
                x: 50px;
                width: parent.width - 70px;
                height: 28px;
                y: (parent.height - self.height) / 2;
                vertical-alignment: center;
                text <=> root.query;
                color: Theme.text;
                font-size: 18px;
                single-line: true;
                selection-background-color: Theme.text-selection;
                selection-foreground-color: Theme.text;
                edited => { root.query-edited(self.text); }
            }
        }

        Rectangle {
            y: 58px;
            height: 1px;
            background: Theme.divider;
        }

        list := Flickable {
            visible: !root.ai-visible;
            x: 0;
            y: 59px;
            width: root.preview-visible ? parent.width - 300px : parent.width;
            content-width: self.width;
            height: parent.height - 59px - 38px;
            content-height: root.results.length > 0
                ? root.results[root.results.length - 1].y + root.results[root.results.length - 1].h + 8px
                : 0px;
            for item[i] in root.results: ResultRow {
                x: 0;
                y: item.y;
                width: list.width;
                item: item;
                selected: i == root.selected;
                clicked => { root.selected = i; root.activate(i, "open"); }
                hovered => { if (!root.actions-open) { root.selected = i; } }
            }
        }

        if root.preview-visible: Rectangle {
            x: parent.width - 300px;
            y: 59px;
            width: 300px;
            height: parent.height - 59px - 38px;
            Rectangle {
                x: 0;
                width: 1px;
                background: Theme.divider;
            }
            VerticalLayout {
                padding: 16px;
                padding-left: 17px;
                spacing: 8px;
                if root.preview-has-image: Rectangle {
                    height: root.preview-thumbnail ? 170px : 64px;
                    Image {
                        width: parent.width;
                        height: parent.height;
                        source: root.preview-image;
                        image-fit: contain;
                        horizontal-alignment: root.preview-thumbnail ? center : left;
                    }
                }
                Text {
                    text: root.preview-title;
                    color: Theme.text;
                    font-size: 13px;
                    font-weight: 600;
                    wrap: word-wrap;
                }
                if root.preview-meta != "": Text {
                    text: root.preview-meta;
                    color: Theme.text-faint;
                    font-size: 11px;
                    wrap: word-wrap;
                }
                if root.preview-text != "": Rectangle {
                    vertical-stretch: 1;
                    clip: true;
                    border-radius: 8px;
                    background: Theme.card-bg;
                    Text {
                        x: 10px;
                        y: 8px;
                        width: parent.width - 20px;
                        text: root.preview-text;
                        color: Theme.text-dim;
                        font-size: 11px;
                        font-family: "Consolas";
                        overflow: clip;
                    }
                }
                // Keeps short content at the top.
                if root.preview-text == "": Rectangle { vertical-stretch: 1; }
            }
        }

        ai-view := Flickable {
            visible: root.ai-visible;
            x: 0;
            y: 59px;
            width: parent.width;
            height: parent.height - 59px - 38px;
            content-width: self.width;
            content-height: ai-column.preferred-height;
            ai-column := VerticalLayout {
                width: parent.width;
                padding: 20px;
                padding-top: 16px;
                spacing: 10px;
                alignment: start;
                Text {
                    text: root.ai-question;
                    color: Theme.text-faint;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                Text {
                    text: root.ai-answer;
                    color: Theme.text;
                    font-size: 14px;
                    wrap: word-wrap;
                }
            }
        }

        if root.results.length == 0 && !root.ai-visible: Text {
            x: 32px;
            y: 59px + 60px;
            width: parent.width - 64px;
            horizontal-alignment: center;
            overflow: elide;
            text: root.empty-text;
            color: Theme.text-faint;
            font-size: 13px;
        }

        // Footer
        Rectangle {
            y: parent.height - 38px;
            height: 38px;
            background: Theme.footer-bg;
            Rectangle {
                y: 0;
                height: 1px;
                background: Theme.divider;
            }
            Rectangle {
                x: 16px;
                y: (parent.height - self.height) / 2;
                width: 14px;
                height: 14px;
                border-radius: 4px;
                background: @linear-gradient(135deg, #ff7a7a 0%, #ff4d6d 100%);
            }
            Text {
                x: 38px;
                y: (parent.height - self.height) / 2;
                text: root.status;
                color: Theme.text-faint;
                font-size: 12px;
            }
            if root.ai-visible: HorizontalLayout {
                width: self.preferred-width;
                x: parent.width - self.width - 14px;
                y: (parent.height - 20px) / 2;
                height: 20px;
                spacing: 6px;
                Text { text: root.ai-status; color: Theme.text-faint; font-size: 12px; vertical-alignment: center; }
                Rectangle { width: 10px; }
                Text { text: "Copy"; color: Theme.text-dim; font-size: 12px; vertical-alignment: center; }
                KeyCap { text: "Enter"; }
                Text { text: "Paste"; color: Theme.text-dim; font-size: 12px; vertical-alignment: center; }
                KeyCap { text: "Ctrl"; }
                KeyCap { text: "Enter"; }
                Text { text: "Back"; color: Theme.text-dim; font-size: 12px; vertical-alignment: center; }
                KeyCap { text: "Esc"; }
            }
            if root.results.length > 0 && !root.ai-visible: HorizontalLayout {
                width: self.preferred-width;
                x: parent.width - self.width - 14px;
                y: (parent.height - 20px) / 2;
                height: 20px;
                spacing: 6px;
                Text {
                    text: root.selected < root.results.length ? root.results[root.selected].action : "";
                    color: Theme.text-dim;
                    font-size: 12px;
                    vertical-alignment: center;
                }
                KeyCap { text: "Enter"; }
                Rectangle {
                    width: 17px;
                    Rectangle {
                        x: 8px;
                        y: 3px;
                        width: 1px;
                        height: 14px;
                        background: Theme.divider;
                    }
                }
                Text {
                    text: "Actions";
                    color: Theme.text-faint;
                    font-size: 12px;
                    vertical-alignment: center;
                }
                KeyCap { text: "Ctrl"; }
                KeyCap { text: "K"; }
            }
        }

        // Action panel (Ctrl+K). A full-size touch area behind it closes it on outside clicks.
        if root.actions-open: TouchArea {
            clicked => { root.actions-open = false; }
        }
        if root.actions-open: Rectangle {
            width: 330px;
            height: 38px + root.actions.length * 34px + 6px;
            x: parent.width - self.width - 12px;
            y: parent.height - 38px - self.height - 8px;
            background: Theme.panel-bg;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.panel-border;
            drop-shadow-blur: 24px;
            drop-shadow-color: Theme.shadow;
            drop-shadow-offset-y: 6px;

            // Clicks on the panel background don't close it.
            TouchArea { }

            Text {
                x: 14px;
                y: 12px;
                width: parent.width - 28px;
                text: root.selected < root.results.length ? root.results[root.selected].title : "";
                overflow: elide;
                color: Theme.text-faint;
                font-size: 11px;
                font-weight: 600;
            }
            for a[i] in root.actions: Rectangle {
                x: 6px;
                y: 34px + i * 34px;
                width: parent.width - 12px;
                height: 32px;
                border-radius: 7px;
                background: i == root.action-selected ? Theme.selection : transparent;
                animate background { duration: 70ms; easing: ease-out; }
                Text {
                    x: 10px;
                    y: (parent.height - self.height) / 2;
                    text: a.title;
                    color: Theme.text;
                    font-size: 13px;
                }
                if a.shortcut != "": KeyCap {
                    x: parent.width - self.width - 8px;
                    y: (parent.height - self.height) / 2;
                    text: a.shortcut;
                }
                TouchArea {
                    clicked => {
                        root.action-selected = i;
                        root.run-selected-action();
                    }
                    moved => { root.action-selected = i; }
                }
            }
        }
    }
}